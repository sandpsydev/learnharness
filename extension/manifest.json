{
  "manifest_version": 3,
  "name": "LearnHarness Medical",
  "description": "Send your Expert AI answers and selected evidence to your local LearnHarness app.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "activeTab", "clipboardWrite", "offscreen"],
  "host_permissions": ["https://ai.uptodate.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "LearnHarness Medical" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["https://ai.uptodate.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }],
  "commands": {
    "ask-next": { "suggested_key": { "default": "Alt+Shift+L", "mac": "MacCtrl+Shift+L" }, "description": "Ask the next queued question in your visible Expert AI tab" }
  }
}
